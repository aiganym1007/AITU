    "@vitejs/devtools-rolldown": "^0.8.3",
    "@vitejs/devtools-vite": "^0.8.3",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^9.2.5",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
